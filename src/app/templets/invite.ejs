<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>You're Invited</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f4f7fc;
        padding: 40px 20px;
      }
      .container {
        max-width: 520px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 48px 40px;
        box-shadow: 0 20px 60px rgba(0, 20, 50, 0.08);
        border: 1px solid #e9edf4;
      }
      .brand {
        text-align: center;
        margin-bottom: 32px;
      }
      .brand h1 {
        font-size: 28px;
        font-weight: 700;
        color: #0b1e33;
      }
      .brand h1 span {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #0b1e33;
        margin-bottom: 12px;
      }
      .greeting span {
        color: #2563eb;
      }
      .message {
        color: #334155;
        font-size: 16px;
        line-height: 1.7;
        margin: 16px 0 24px;
      }
      .btn {
        display: inline-block;
        background: #2563eb;
        color: #ffffff !important;
        padding: 14px 32px;
        text-decoration: none;
        border-radius: 40px;
        font-weight: 600;
        font-size: 16px;
        margin: 16px 0;
      }
      .btn:hover {
        background: #1d4ed8;
      }
      .footer {
        text-align: center;
        color: #94a3b8;
        font-size: 13px;
        margin-top: 32px;
        border-top: 1px solid #e9edf4;
        padding-top: 24px;
      }
      .expiry {
        font-size: 14px;
        color: #64748b;
        margin-top: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="brand">
        <h1>🏢 <span>SalesNexus</span></h1>
      </div>
      <p class="greeting">Hello, <span><%= name %></span> 👋</p>
      <p class="message">
        You have been invited to join
        <strong><%= organizationName %></strong> as a
        <strong><%= role %></strong>. <br /><br />
        Click the button below to complete your registration.
      </p>
      <div style="text-align: center">
        <a href="<%= inviteLink %>" class="btn">Accept Invitation</a>
      </div>
      <p class="expiry">
        ⏳ This link will expire in <strong><%= expiryDays %></strong> days.
      </p>
      <div class="footer">
        <p style="margin-bottom: 4px">
          If you didn't request this, please ignore this email.
        </p>
        <p>
          &copy; <%= new Date().getFullYear() %> SalesNexus. All rights
          reserved.
        </p>
      </div>
    </div>
  </body>
</html>
