<!-- src/app/templates/otp.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification OTP</title>
    <style>
      /* ----- RESET & BASE ----- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background-color: #f4f7fc;
        padding: 40px 20px;
        line-height: 1.6;
      }
      .container {
        max-width: 520px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 48px 40px 36px;
        box-shadow: 0 20px 60px rgba(0, 20, 50, 0.08);
        border: 1px solid #e9edf4;
      }

      /* ----- HEADER / BRAND ----- */
      .brand {
        text-align: center;
        margin-bottom: 32px;
      }
      .brand h1 {
        font-size: 28px;
        font-weight: 700;
        color: #0b1e33;
        letter-spacing: -0.5px;
      }
      .brand h1 span {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .brand .tagline {
        font-size: 14px;
        color: #64748b;
        margin-top: 4px;
      }

      /* ----- GREETING ----- */
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #0b1e33;
        margin-bottom: 8px;
      }
      .greeting span {
        color: #2563eb;
      }

      /* ----- OTP CODE BOX ----- */
      .otp-box {
        background: #f8faff;
        border: 2px dashed #2563eb20;
        border-radius: 16px;
        padding: 28px 20px;
        text-align: center;
        margin: 24px 0 28px;
        transition: 0.2s ease;
      }
      .otp-box .label {
        font-size: 14px;
        color: #475569;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      .otp-box .code {
        font-size: 44px;
        font-weight: 700;
        letter-spacing: 12px;
        color: #0b1e33;
        font-family: "Courier New", monospace;
        background: #ffffff;
        padding: 12px 16px;
        border-radius: 12px;
        display: inline-block;
        margin-top: 8px;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.06);
        border: 1px solid #e2e8f0;
      }

      /* ----- MESSAGE ----- */
      .message {
        color: #334155;
        font-size: 16px;
        text-align: center;
        margin: 20px 0 12px;
      }
      .message strong {
        color: #0b1e33;
      }

      /* ----- EXPIRY NOTE ----- */
      .expiry-note {
        text-align: center;
        font-size: 14px;
        color: #94a3b8;
        background: #f1f5f9;
        padding: 10px 16px;
        border-radius: 40px;
        display: inline-block;
        margin: 0 auto 12px;
        width: auto;
      }
      .expiry-note span {
        font-weight: 600;
        color: #475569;
      }

      /* ----- DIVIDER ----- */
      .divider {
        border: none;
        border-top: 1px solid #e9edf4;
        margin: 32px 0 24px;
      }

      /* ----- FOOTER ----- */
      .footer {
        text-align: center;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.8;
      }
      .footer .brand-name {
        font-weight: 600;
        color: #475569;
      }
      .footer .help-link {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }
      .footer .help-link:hover {
        text-decoration: underline;
      }

      /* ----- RESPONSIVE ----- */
      @media (max-width: 480px) {
        .container {
          padding: 32px 20px 28px;
        }
        .otp-box .code {
          font-size: 32px;
          letter-spacing: 8px;
          padding: 10px 12px;
        }
        .brand h1 {
          font-size: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- ===== BRAND ===== -->
      <div class="brand">
        <h1>🏢 <span>SalesNexus</span></h1>
        <div class="tagline">Smart CRM · Smarter Sales</div>
      </div>

      <!-- ===== GREETING ===== -->
      <p class="greeting">Hello, <span><%= name || 'there' %></span> 👋</p>

      <!-- ===== MESSAGE ===== -->
      <p class="message">
        Use the One-Time Password (OTP) below to verify your email address.
        <br />
        <strong>This code is valid for 10 minutes.</strong>
      </p>

      <!-- ===== OTP CODE ===== -->
      <div class="otp-box">
        <div class="label">🔐 Your Verification Code</div>
        <div class="code"><%= otp %></div>
      </div>

      <!-- ===== EXPIRY NOTE ===== -->
      <div style="text-align: center">
        <span class="expiry-note"> ⏳ Expires in <span>5 minutes</span> </span>
      </div>

      <!-- ===== SECURITY NOTE ===== -->
      <p
        style="
          text-align: center;
          font-size: 14px;
          color: #64748b;
          margin-top: 16px;
        "
      >
        If you didn’t request this, please ignore this email.
      </p>

      <hr class="divider" />

      <!-- ===== FOOTER ===== -->
      <div class="footer">
        <p>
          <span class="brand-name">SalesNexus</span> — Helping teams close deals
          faster.
        </p>
        <p style="margin-top: 4px">
          Need help?
          <a href="mailto:support@salesnexus.com" class="help-link"
            >support@salesnexus.com</a
          >
        </p>
        <p style="font-size: 12px; color: #cbd5e1; margin-top: 12px">
          &copy; <%= new Date().getFullYear() %> SalesNexus. All rights
          reserved.
        </p>
      </div>
    </div>
  </body>
</html>
